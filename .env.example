# ccremote — Example configuration
#
# Copy this file to `.env` and edit values for your environment.
# In production, `NODE_ENV=production` is expected. The relay server will
# refuse to boot if AUTH_TOKEN is empty or left as the default sentinel.
#
# Generate a strong token:
#   openssl rand -hex 32
#
# ─────────────────────────────────────────────────────────────────────────
# Production quickstart
# ─────────────────────────────────────────────────────────────────────────
#   1. cp .env.example .env
#      Set AUTH_TOKEN, CORS_ORIGINS, NEXT_PUBLIC_RELAY_URL.
#   2. pnpm install
#   3. pnpm start:prod        # builds + starts under PM2 on prod ports
#                             # (web 24100, docs 24102, relay 24300)
#   4. pnpm logs:prod
# ─────────────────────────────────────────────────────────────────────────


# === Relay Server =========================================================

# REQUIRED in production. Shared secret between the relay server and clients.
# DO NOT ship the default value to production — the relay will exit on boot.
AUTH_TOKEN="change-me-in-production"

# Bind address and port for the relay WebSocket server.
# Dev default is 14300; production (pnpm start:prod / docker prod) uses 24300.
RELAY_PORT=14300
RELAY_HOST="0.0.0.0"

# Comma-separated list of host paths the file browser is allowed to read.
# Keep this as narrow as possible (e.g. "/home/deploy/projects").
ALLOWED_PATHS="/home"

# Optional: explicit tmux socket path. Leave empty to use tmux's default.
# On Linux the default is typically /tmp/tmux-$(id -u)/default.
TMUX_SOCKET=""

# Shell used for newly created tmux sessions.
TMUX_DEFAULT_SHELL="/bin/bash"

# Max WS messages per rate-limit window per connection.
WS_RATE_LIMIT=100

# Idle-disconnect timeout (minutes).
IDLE_TIMEOUT_MINUTES=30

# REQUIRED in production. Comma-separated list of allowed web origins.
# Must include the exact public origin of the web app, e.g.
#   CORS_ORIGINS="https://ccremote.example.com"
CORS_ORIGINS="http://localhost:14100"


# === Web App =============================================================

# REQUIRED for the SPLIT deployment (Docker/PM2), where the relay listens on
# its own port. Public WebSocket URL the browser uses to reach the relay.
# In production use `wss://` (TLS) — the browser will refuse `ws://` from
# an `https://` page. Production default port is 24300 (dev: 14300).
#
# Leave it UNSET for single-port mode (`tmuxremote start`, `pnpm dev`): the
# browser then uses the page's own origin plus `/_relay`. Setting it here
# overrides that, which is why `pnpm dev:split` passes it explicitly rather
# than relying on this file.
NEXT_PUBLIC_RELAY_URL="ws://localhost:14300"

# Optional override of the web app port (must match your reverse proxy).
# Dev default 14100; production default 24100.
WEB_PORT=14100


# === Docs Site ===========================================================

# Optional override of the docs app port.
# Dev default 14102; production default 24102.
DOCS_PORT=14102


# === Pairing Broker (apps/api) ===========================================
#
# Only needed if you HOST the broker yourself. Nothing in `mtmux start` or the
# self-hosted split deployment talks to it unless the user runs `mtmux pair`.

# Bind address and port for the broker. Dev 14400; production 24400.
API_PORT=14400
API_HOST="127.0.0.1"

# Public origin of the broker, used by the CLI and the hosted web app.
NEXT_PUBLIC_API_URL="http://localhost:14400"

# Comma-separated origins allowed to call the broker's HTTP endpoints.
API_CORS_ORIGINS="http://localhost:14100"

# Abuse controls. Per-IP sliding windows; tunnel quotas are per tunnel.
API_CLAIMS_PER_MINUTE=5
API_MAILBOXES_PER_MINUTE=10
API_TUNNEL_MAX_BYTES=1073741824
API_TUNNEL_MAX_MINUTES=720

# === Reverse DNS and per-device TLS (apps/api, Phase 3) ==================
#
# Leave empty to disable. Without these the broker still pairs and tunnels;
# it just cannot hand out <slug>.lan.<zone> names or certificates, so every
# remote session goes over the tunnel instead of racing a direct candidate.

# Cloudflare API token with DNS:Edit on the zone below.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# Zone the broker manages, e.g. "mtmux.com". Records are created under
# <slug>.lan.<zone> (RFC1918 address) and <slug>.d.<zone> (public address).
DNS_ZONE=""

# ACME account email and directory for per-device certificates.
# Certificate issuance stays OFF unless ACME_ENABLED=true: Let's Encrypt caps
# certificates at 50 per registered domain per week, which is a hard ceiling
# at any real scale. Get a rate-limit exemption or a CA with EAB first.
ACME_ENABLED=false
ACME_DIRECTORY="https://acme-v02.api.letsencrypt.org/directory"


# === Reverse Proxy (optional) ============================================
#
# These are only consumed by the bundled `nginx/` configs. They are safe to
# leave unset if you terminate TLS elsewhere (e.g. Caddy, Cloudflare, a
# managed load balancer).

# Public domain name the app is served from, e.g. "ccremote.example.com".
PUBLIC_DOMAIN=""

# Email used by certbot / Let's Encrypt for expiry notices.
ACME_EMAIL=""
