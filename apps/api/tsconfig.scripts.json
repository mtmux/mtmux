{
  // The operational scripts, typechecked separately because the main config
  // pins `rootDir: src` so the build emits a flat `dist/`. Without this file
  // nothing would ever check them, and a script that only runs at deploy time
  // is exactly the code that must not break silently.
  "extends": "@repo/tsconfig/node.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
