{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_*",
    "RELAY_PORT",
    "RELAY_HOST",
    "AUTH_TOKEN",
    "ALLOWED_PATHS",
    "TMUX_SOCKET",
    "CORS_ORIGINS",
    "API_PORT",
    "API_HOST",
    "API_CORS_ORIGINS",
    "API_CLAIMS_PER_MINUTE",
    "API_MAILBOXES_PER_MINUTE",
    "API_TUNNEL_MAX_BYTES",
    "API_TUNNEL_MAX_MINUTES",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ZONE_ID",
    "DNS_ZONE",
    "ACME_ENABLED",
    "ACME_DIRECTORY",
    "ACME_EMAIL"
  ]
}
